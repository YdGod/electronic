{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryPet skin manifest v1",
  "type": "object",
  "required": ["SchemaVersion", "Id", "Name", "Author", "License", "Frames"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "Name": { "type": "string", "minLength": 1 },
    "Description": { "type": "string" },
    "Author": { "type": "string", "minLength": 1 },
    "License": { "type": "string", "minLength": 1 },
    "Frames": {
      "type": "object",
      "required": ["Idle"],
      "properties": {
        "Idle": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.png$" },
        "Popup": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.png$" }
      }
    }
  }
}
