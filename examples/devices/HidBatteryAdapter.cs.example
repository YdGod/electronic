            // a finite timeout. Parse the response in a separate pure method.
            throw new NotSupportedException("Implement the verified read-only query first.");
        }

        internal static DeviceBattery Parse(byte[] response)
        {
            // Validate length, report ID, command, status, checksum and child identity.
            // Do not fill fields from guessed offsets or fabricate a percentage.
            return null;
        }
    }
