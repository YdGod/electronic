    {
        public string Id { get { return "example-model"; } }

        public bool Supports(HidDescriptor descriptor)
        {
            // Replace with verified VID/PID + product + usage + lengths + report IDs.
            // Keep false until the actual device and read-only protocol are established.
            return false;
        }

        public DeviceBattery Read(HidDescriptor descriptor, CancellationToken cancellation)
        {
            cancellation.ThrowIfCancellationRequested();
